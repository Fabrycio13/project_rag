# Copy this file to .env.local and use development credentials.
# Never put real secrets in this template or commit .env.local.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (use a publishable key for normal app requests; enforce RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: only if a trusted server-side worker later needs privileged access.
# Keep server-only; never expose through a NEXT_PUBLIC_ variable.
# SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# AI provider has not been selected yet. Add its provider-specific secret here
# only after selection; it must remain server-only (never NEXT_PUBLIC_).
