# Copy this file to .env.local and use development credentials.
# Never put real secrets in this template or commit .env.local.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Development test on the same computer: http://localhost:3000.
# For invitees on other devices, use the app's public HTTPS URL.
APP_BASE_URL=

# Supabase (use a publishable key for normal app requests; enforce RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required by the server to atomically activate an accepted admin invitation.
# Keep server-only; never expose through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Legacy alternative, if the project still uses a service-role JWT.
# SUPABASE_SERVICE_ROLE_KEY=

# AI provider has not been selected yet. Add its provider-specific secret here
# only after selection; it must remain server-only (never NEXT_PUBLIC_).
